# ── EasyMindMap API 환경변수 (예시) ────────────────────────────
# 실제 값은 .env 로 복사해 채우고, .env 는 절대 커밋하지 않습니다.
# (.gitignore 에 이미 .env 포함)

# 서버
PORT=3000
# 프론트엔드 출처(CORS 허용). 개발 기본값:
CORS_ORIGIN=http://localhost:5173

# 데이터베이스 (PostgreSQL 16 + ltree)
# 로컬 개발: docker-compose.dev.yml 또는 로컬 postgres
DATABASE_URL=postgres://emm:emm@localhost:5432/easymindmap

# 인증 모드
#   dev      = 개발 스텁(헤더 x-user-id 또는 DEV_USER_ID 로 사용자 지정)
#   supabase = Supabase Auth JWT 검증 (다음 단계에서 구현)
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── vault 미러 (셀프호스트 전용, 2026-08-23) ───────────────────
# 맵을 사람이 읽는 .md 파일 트리로 계속 내보낸다.
#   docs/04-extensions/vault-mirror.md
#
# **비어 있으면 꺼진다.** 클라우드 배포에는 사용자의 디스크가 없다(§2).
# 반드시 **빈 폴더**를 준다 — 남의 파일이 있는 폴더는 거절한다(§7).
# 도커라면 볼륨을 물린 경로를 쓴다: VAULT_DIR=/data/vault
VAULT_DIR=

# ── (다음 단계) Supabase / Redis / AI ─────────────────────────
# SUPABASE_URL=https://supabase.example.com
# SUPABASE_SERVICE_ROLE_KEY=            # 서버 전용, 클라이언트 노출 금지
# SUPABASE_JWT_SECRET=
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── 레이트 리밋 (2026-08-08) ──────────────────────────────────
# "한 사람이 정해진 시간 안에 부를 수 있는 최대 횟수".
# 왜 필요한지·한도를 어떻게 정했는지는
#   docs/05-implementation/rate-limit.md
#
# 기본값 = 60초 안에 600번. 정상 사용의 수십 배로 넉넉하다
# (우리 앱은 자동저장이 5분 주기라 평상시 요청이 매우 적다).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# false 로 두면 레이트 리밋을 끈다. 부하 테스트 등 특수한 경우에만.
RATE_LIMIT_ENABLED=true
