{
  "name": "@easymindmap/api",
  "version": "0.1.0",
  "private": true,
  "description": "EasyMindMap 백엔드 API (NestJS + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "type-check": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "db:apply": "node scripts/apply-schema.mjs",
    "test:vault": "node test/vault-path.test.mjs && node test/vault-writer.test.mjs && node test/vault-plan.test.mjs",
    "test:ai-keys": "node test/ai-key-crypto.test.mjs",
    "test:mcp": "node test/emm-to-doc.test.mjs && node test/doc-to-emm.test.mjs && node test/append-to-map.test.mjs && node test/map-template.test.mjs && node test/mcp-jsonrpc.test.mjs",
    "test:schema-degrade": "node test/schema-degrade.test.mjs",
    "test:table-ready": "node test/table-ready.test.mjs",
    "test:version-prune": "node test/version-prune-plan.test.mjs",
    "sync:emm": "node scripts/sync-emm-parser.mjs",
    "check:emm": "node scripts/sync-emm-parser.mjs --check"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@types/nodemailer": "^8.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
