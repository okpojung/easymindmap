{
  "name": "@easymindmap/api",
  "version": "0.1.0",
  "private": true,
  "description": "EasyMindMap 백엔드 API (NestJS + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
