{
  "name": "@easymindmap/emm-parser",
  "version": "0.1.0",
  "description": "EasyMindMap Markdown (EMM) reference parser/serializer — Markdown ↔ mindmap JSON with lossless metadata layer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "test": "tsx conformance/run.ts",
    "test:update": "tsx conformance/run.ts --update",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finish-dist.mjs",
    "prepublishOnly": "npm run build",
    "test:unit": "tsx test/build-tree.test.ts"
  },
  "keywords": [
    "mindmap",
    "markdown",
    "emm",
    "easymindmap",
    "parser"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
