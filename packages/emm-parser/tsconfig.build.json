{
  // 배포용 산출물 빌드 — **원본 tsconfig 는 검사 전용**(noEmit)이라 따로 둔다.
  //
  // 왜 필요한가: 이 패키지의 `main` 이 `src/index.ts` 였다. 번들러(vite)는
  // 소스를 그대로 읽지만 **Node 는 못 읽는다** — TypeScript 이기 때문이다.
  // 그래서 이 패키지는 사실상 **이 저장소 안에서만** 쓸 수 있었다.
  // 서버(NestJS)가 트리 규칙을 `require` 하면서 드러났다 — EMM 의 레퍼런스
  // 구현이라면서 정작 제3자가 설치해 쓸 수 없는 모양이었다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "rootDir": "src"
  },
  "include": ["src"]
}
