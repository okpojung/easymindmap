# /etc/emm-backup.env — 운영 DB 호스트(VM-03, 네이티브 PostgreSQL)의 백업 설정
#
# dev 는 api 컨테이너의 환경변수에서 메일 설정을 읽지만, VM-03 에는 api
# 컨테이너가 없어 여기서 읽는다. root 소유 600 으로 둔다:
#   sudo install -m 600 -o root -g root emm-backup.env.example /etc/emm-backup.env
#   sudo nano /etc/emm-backup.env
# cron 줄의 환경변수가 이 파일보다 우선한다 (파일은 기본값).
# 값에 공백·<> 가 있으면 따옴표로 감싼다 (양끝 따옴표는 벗겨서 읽는다).

# ── PostgreSQL ────────────────────────────────────────────────────
PG_MODE=native            # native = 이 호스트의 PostgreSQL (docker = Coolify 컨테이너, dev)
PGUSER=postgres           # runuser -u <이 계정> -- psql|pg_dumpall (소켓 peer 인증 — 비밀번호 불필요)

# ── 실패 알림 메일 (health-watch 와 같은 SMTP) ───────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587             # 465 면 smtps
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyMindMap <noreply@example.com>"
ALERT_EMAILS=ops@example.com          # 쉼표로 여럿

# ── 보관·서버 밖 사본 ─────────────────────────────────────────────
DEST=/var/backups/emm
KEEP_DAYS=14
OFFSITE_DIR=/mnt/nas/emm-db-backup/prod   # NAS hng2 (런북 §2.1 ②) — 안에 .emm-offsite 표식 필요
OFFSITE_KEEP_DAYS=60
